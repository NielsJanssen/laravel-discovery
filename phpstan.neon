includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 10

    paths:
        - packages/laravel-discovery/src
        - packages/laravel-discovery-graphql/src
        - packages/laravel-validation/src
        - tests/TestCase.php
        - benchmarks

    excludePaths:
        - benchmarks/.generated (?)

    reportIgnoresWithoutComments: true
